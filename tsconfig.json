{
	"include": ["**/*.ts", "*.js"],
	"exclude": ["**/snapshots/*"],
	"compilerOptions": {
		"target": "es2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	}
}
